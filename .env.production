# ══════════════════════════════════════════════════════════════
# ThaiEstate 生产环境配置
# 复制此文件为 .env 并填入真实值
# ══════════════════════════════════════════════════════════════

# ── 数据库 ──
POSTGRES_USER=thaiestate
POSTGRES_PASSWORD=请生成随机强密码
POSTGRES_DB=thai_estate_db

# ── JWT 密钥 (用 openssl rand -hex 32 生成) ──
JWT_SECRET_KEY=请生成256位随机密钥

# ── 前端 ──
NEXT_PUBLIC_API_URL=/api/v1

# ── CORS ──
CORS_ORIGINS=["https://your-domain.com"]

# ── OpenAI ──
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Google Maps ──
GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx

# ── LINE Messaging API ──
LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# ── n8n (可选) ──
N8N_WEBHOOK_URL=
N8N_HOST=n8n.your-domain.com
N8N_ENCRYPTION_KEY=请生成随机密钥
