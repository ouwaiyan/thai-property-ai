APP_NAME=Thai Estate API
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thai_estate_db
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/thai_estate_db
JWT_SECRET_KEY=change-me-in-production-use-256-bit-key-thai-estate
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000"]
UPLOAD_DIR=uploads/properties
MAX_UPLOAD_SIZE_MB=10

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Maps
GOOGLE_MAPS_API_KEY=
ROUTING_PROVIDER=google_routes
ROUTE_MATRIX_MAX_CANDIDATES=50
ROUTE_MATRIX_DAILY_API_LIMIT=100

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# n8n Automation (optional, P1)
N8N_WEBHOOK_URL=
